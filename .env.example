# Backend running on the host; MongoDB/Redis supplied by Docker Compose.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ticketbox?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=ticketbox
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Must match REDIS_PASSWORD in the root .env file.
REDIS_PASSWORD=ticketbox-local-redis
JWT_SECRET=ticketbox-local-jwt-change-before-deploy
JWT_EXPIRES_IN=7d
QR_SECRET=ticketbox-local-qr-change-before-deploy
