{
  "name": "eventix-backend",
  "version": "1.0.0",
  "description": "Eventix High-Concurrency Ticket Booking Backend (Ticketbox.vn clone)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/seed.ts",
    "export:db": "node scripts/export-db.cjs",
    "test:integration": "npm run build && node scripts/test-integration.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2"
  }
}
